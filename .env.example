# Copy to .env and adjust. Never commit .env.

# Dev database (docker compose, host port 5433)
DATABASE_URL=postgres://white_lotus:white_lotus@localhost:5433/white_lotus
# Test database, used by tests and `npm run db:migrate:test`
DATABASE_URL_TEST=postgres://white_lotus:white_lotus@localhost:5433/white_lotus_test

# API
PORT=4000
WEB_ORIGIN=http://localhost:5173
# Shared secret for admin routes (x-admin-key header). Use a long random value.
ADMIN_KEY=change-me-to-a-long-random-string
